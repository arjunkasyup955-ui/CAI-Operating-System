# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment
.env
.env.*
!.env.example

# Ollama
.ollama/

# Logs
*.log

# Database
*.db
*.db-shm
*.db-wal

# Chroma persistent store (chroma.sqlite3 + per-collection UUID dirs of
# HNSW index .bin files - regenerated locally, same treatment as *.db above)
database/chroma/

# Process artifacts from detached background runs (Start-Process -PassThru
# PID capture, scripts/*.pid) - never meant to be committed, only swept in by
# AI Builder's own git-add-all commit step (see docs/bug_investigation_log.md)
*.pid

# VS Code
.vscode/

# OS Files
.DS_Store
Thumbs.db

# Generated reports (regenerated on every demo/validation run - same
# treatment as *.db above; nothing in the codebase depends on these being
# tracked, confirmed via grep across scripts/smoke_test_phase*.py)
outputs/