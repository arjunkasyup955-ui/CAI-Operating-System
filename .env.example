# LLM providers
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Ollama (local models) - only needs a running local server, no API key
OLLAMA_BASE_URL=http://localhost:11434

# Search Agent providers (tools/web) - primary then fallbacks, all optional
SEARXNG_BASE_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# Browser Agent providers (tools/browser) - Playwright/Crawl4AI need local packages
# installed; Firecrawl is a hosted API key, all optional
FIRECRAWL_API_KEY=

# LangSmith tracing (optional but recommended)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=afos-dev

# Storage
AFOS_DB_PATH=database/afos.db

# Budget Manager
AFOS_MONTHLY_BUDGET_USD=50.0
AFOS_VENTURE_BUDGET_USD=10.0
